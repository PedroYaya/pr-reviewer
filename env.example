# GitHub App
GITHUB_APP_ID=your_app_id_here
GITHUB_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nYour private key here\n-----END RSA PRIVATE KEY-----
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Queue shared by the gateway and reviewer services
REDIS_URL=redis://localhost:6379/0
REVIEW_QUEUE_NAME=pr-review-jobs
# On AWS: QUEUE_BACKEND=sqs plus the queue URLs (Redis is still used for caches and drafts)
QUEUE_BACKEND=redis
# SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/pr-reviewer-jobs
# SQS_DEAD_LETTER_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/pr-reviewer-jobs-dlq
# AWS_REGION=us-east-1

LOG_LEVEL=INFO
# json (one object per line, for log aggregation) or text
LOG_FORMAT=json

# RAG and token budget (optional; defaults shown)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DIFF_TOKEN_BUDGET=24000
FILE_TOKEN_BUDGET=6000
CONVENTIONS_TOP_K=6

# Guardrails and human-in-the-loop
# auto: publish reviews directly. approval: post a draft; a maintainer comments
# "/ai-review approve" to publish it or "/ai-review dismiss" to discard it.
REVIEW_MODE=auto
MAX_FINDINGS=15

# Review history for the dashboard API (SQLite file; any SQLAlchemy URL works)
HISTORY_DATABASE_URL=sqlite:///reviews.db

# Retries (optional; defaults shown)
OPENAI_MAX_RETRIES=4
OPENAI_TIMEOUT_SECONDS=120
GITHUB_MAX_ATTEMPTS=4
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=30

# Tracing: off unless set. Needs `pip install -e ".[otel]"`.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

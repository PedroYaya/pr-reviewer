# GitHub App
GITHUB_APP_ID=your_app_id_here
GITHUB_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nYour private key here\n-----END RSA PRIVATE KEY-----
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Queue shared by the gateway and reviewer services
REDIS_URL=redis://localhost:6379/0
REVIEW_QUEUE_NAME=pr-review-jobs

LOG_LEVEL=INFO

# RAG and token budget (optional; defaults shown)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DIFF_TOKEN_BUDGET=24000
FILE_TOKEN_BUDGET=6000
CONVENTIONS_TOP_K=6

# Guardrails and human-in-the-loop
# auto: publish reviews directly. approval: post a draft; a maintainer comments
# "/ai-review approve" to publish it or "/ai-review dismiss" to discard it.
REVIEW_MODE=auto
MAX_FINDINGS=15

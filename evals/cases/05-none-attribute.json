        "     if event_type == \"invoice.paid\":",
        "         mark_paid(payload[\"data\"][\"invoice_id\"])",
        "+    elif event_type == \"customer.updated\":",
        "+        customer = payload[\"data\"][\"customer\"]",
        "+        email = customer.get(\"email\")",
        "+        send_welcome(email.lower())",
        "+    return {\"ok\": True}"

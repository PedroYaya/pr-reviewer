        "@@ -0,0 +1,9 @@",
        "+def paginate(items, page, page_size):",
        "+    \"\"\"Return the 1-indexed page of items.\"\"\"",
        "+    start = page * page_size",
        "+    end = start + page_size",
        "+    return items[start:end]",
        "+",
        "+",
        "+def page_count(total, page_size):",
        "+    return total // page_size"
      ]
    }

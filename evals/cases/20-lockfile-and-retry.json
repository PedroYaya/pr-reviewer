    {
      "filename": "app/retry.py",
      "status": "added",
      "additions": 10,
      "patch": [
        "@@ -0,0 +1,10 @@",
        "+import time",
        "+",
        "+",
        "+def call_with_retry(fn, attempts=3, delay=1.0):",
        "+    for attempt in range(attempts):",
        "+        try:",
        "+            return fn()",
        "+        except Exception:",
        "+            time.sleep(delay)",
        "+    return None"
      ]
    }
  ],
  "expected": [
    {
      "id": "silent-failure",
      "path": "app/retry.py",
      "lines": [
        8,
        10
      ],
      "category": "bug",
      "description": "After the last attempt the error is discarded and None is returned, so callers can't tell failure from success; re-raise the last exception."
    }
  ]
